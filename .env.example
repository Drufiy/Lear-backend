# Prash v2 — credential template
#
# Copy to `.env` and fill in. `.env` is gitignored and MUST stay that way:
# the entire trust model of Prash v2 is that these values never leave the
# user's machine. Nothing here is ever transmitted to Drufiy.
#
# OWNER OF THIS FILE'S SCHEMA: Aryan (Track A owns config loading).
# Adding a new key here = log it in PRASH_V2.md §10 so the other track knows.

# ─── Model provider (the diagnosis brain) ────────────────────────────────
# At least one required.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6
GEMINI_API_KEY=

# ─── GitHub (CI logs, opening fix PRs) ───────────────────────────────────
# Needs: repo, workflow
GITHUB_TOKEN=

# ─── GitLab (CI pipeline logs, opening fix MRs — Sprint 2 Tier 2) ────────
# Personal/project access token. Needs: api, read_repository, write_repository
# gitlab.com only for now — no self-hosted base URL yet.
GITLAB_TOKEN=

# ─── Kubernetes ──────────────────────────────────────────────────────────
# Path to kubeconfig. Leave blank to use the default (~/.kube/config).
# KUBE_CONTEXT selects which cluster if the config has several.
KUBECONFIG=
KUBE_CONTEXT=
KUBE_NAMESPACE=default

# ─── Google Cloud (Cloud Run & Compute Engine) ───────────────────────────
GCP_PROJECT_ID=
GCP_REGION=
# Path to a service-account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=

# ─── Microsoft Azure (VMs) ───────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_LOCATION=

# ─── AWS (read-only this sprint) ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# ─── Vercel ──────────────────────────────────────────────────────────────
VERCEL_TOKEN=

# ─── Datadog (monitor state + logs, read-only — Sprint 2 Tier 3) ─────────
# API key: org settings -> API Keys. App key: org settings -> Application Keys
# (needed for monitors/logs; API key alone only proves auth via /v1/validate).
DATADOG_API_KEY=
DATADOG_APP_KEY=
# Leave blank for the default US1 site (datadoghq.com). Set to your org's
# actual site host if you're on EU/US3/US5/AP1, e.g. datadoghq.eu.
DATADOG_SITE=

# ─── Grafana (alert state + annotations, read-only — Sprint 2 Tier 3) ────
# No default host -- every install is its own URL (self-hosted or a Grafana
# Cloud org like https://myorg.grafana.net). No trailing slash.
GRAFANA_URL=
# Legacy API key or a newer service account token -- same Bearer header either way.
GRAFANA_API_KEY=

# ─── PagerDuty (incident state + acknowledge/resolve — Sprint 2 Tier 3) ──
# REST API key: account settings -> API Access Keys.
PAGERDUTY_API_KEY=
# Required ONLY for acknowledge/resolve (not for reads) -- PagerDuty's API
# needs a real user email to attribute the change to. Use an account admin
# or a dedicated bot user's email that exists on this PagerDuty account.
PAGERDUTY_FROM_EMAIL=

# ─── Snyk (project issue state, read-only — Sprint 2 Tier 3) ─────────────
SNYK_API_TOKEN=
# Snyk's API is org-scoped end to end -- find this under org settings.
SNYK_ORG_ID=

# ─── Gitleaks (local secret scanning — Sprint 2 Tier 3) ──────────────────
# Not a hosted service -- runs the gitleaks binary locally against a git
# checkout you point it at (e.g. `prash investigate . --provider gitleaks`).
# Leave blank to use `gitleaks` from PATH; set only if it's not on PATH or
# you want a specific binary.
GITLEAKS_BINARY=

# ─── Prash behaviour ─────────────────────────────────────────────────────
# One of: read-only | ask | auto-safe | environment-scoped | bypass
PRASH_PERMISSION_MODE=ask

# Which environment this config points at. Used by environment-scoped mode
# to decide what may run without asking. One of: staging | production
PRASH_ENVIRONMENT=staging

# Where the local audit log is written
PRASH_AUDIT_LOG_PATH=.prash/audit.log

# ─── Circuit breaker (day-7 safety rail) ────────────────────────────────
# Hard cap on actions per resource per time window. On breach, Prash stops
# acting on that resource and escalates to a human (`prash circuit reset`).
PRASH_CIRCUIT_MAX_ACTIONS=5
PRASH_CIRCUIT_WINDOW_SECONDS=60
PRASH_CIRCUIT_STATE_PATH=.prash/circuit.json

# ─── Watcher (Track E — `prash watch`) ───────────────────────────────────
# Poll interval, in seconds, for checking pod status.
PRASH_WATCH_INTERVAL_SECONDS=30

# ─── Team notifications (Sprint 2 Tier 2 — `prash watch` + `prash notify`) ─
# Incoming-webhook URLs. Leave blank to skip that channel. When set, the
# watcher pushes its pings here so the whole team sees them, not just one
# laptop's desktop toast.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Email Notifications (SMTP)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# WhatsApp Notifications (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_FROM_NUMBER=
WHATSAPP_TO_NUMBERS=
