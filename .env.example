# Prash v2 — credential template
#
# Copy to `.env` and fill in. `.env` is gitignored and MUST stay that way:
# the entire trust model of Prash v2 is that these values never leave the
# user's machine. Nothing here is ever transmitted to Drufiy.
#
# OWNER OF THIS FILE'S SCHEMA: Aryan (Track A owns config loading).
# Adding a new key here = log it in PRASH_V2.md §10 so the other track knows.

# ─── Model provider (the diagnosis brain) ────────────────────────────────
# At least one required.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6
GEMINI_API_KEY=

# ─── GitHub (CI logs, opening fix PRs) ───────────────────────────────────
# Needs: repo, workflow
GITHUB_TOKEN=

# ─── Kubernetes ──────────────────────────────────────────────────────────
# Path to kubeconfig. Leave blank to use the default (~/.kube/config).
# KUBE_CONTEXT selects which cluster if the config has several.
KUBECONFIG=
KUBE_CONTEXT=
KUBE_NAMESPACE=default

# ─── Google Cloud (Cloud Run) ────────────────────────────────────────────
GCP_PROJECT_ID=
GCP_REGION=
# Path to a service-account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=

# ─── AWS (read-only this sprint) ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# ─── Vercel ──────────────────────────────────────────────────────────────
VERCEL_TOKEN=

# ─── Prash behaviour ─────────────────────────────────────────────────────
# One of: read-only | ask | auto-safe | environment-scoped | bypass
PRASH_PERMISSION_MODE=ask

# Which environment this config points at. Used by environment-scoped mode
# to decide what may run without asking. One of: staging | production
PRASH_ENVIRONMENT=staging

# Where the local audit log is written
PRASH_AUDIT_LOG_PATH=.prash/audit.log

# ─── Circuit breaker (day-7 safety rail) ────────────────────────────────
# Hard cap on actions per resource per time window. On breach, Prash stops
# acting on that resource and escalates to a human (`prash circuit reset`).
PRASH_CIRCUIT_MAX_ACTIONS=5
PRASH_CIRCUIT_WINDOW_SECONDS=60
PRASH_CIRCUIT_STATE_PATH=.prash/circuit.json

# ─── Watcher (Track E — `prash watch`) ───────────────────────────────────
# Poll interval, in seconds, for checking pod status.
PRASH_WATCH_INTERVAL_SECONDS=30
